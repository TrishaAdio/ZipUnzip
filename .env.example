# ─────────────────────────────────────────────────────────────────────────────
#  unzipper-bot
# ─────────────────────────────────────────────────────────────────────────────

BOT_TOKEN=123456:ABC-DEF

# Comma separated user ids. Empty = open to everyone.
ALLOWED_USERS=
# Comma separated chat ids the bot will work in. Empty = any chat.
ALLOWED_CHATS=

# ── Local Bot API server ─────────────────────────────────────────────────────
# The public api.telegram.org can only *download* files up to 20 MB and only
# *upload* up to 50 MB. Point this at a local telegram-bot-api instance to get
# 2000 MB in both directions, then uncomment both lines below. See deploy/.
# Unset means api.telegram.org.
#API_BASE_URL=http://127.0.0.1:8081
# --dir of the telegram-bot-api process. Must be readable by this bot.
#API_DIR=/var/lib/telegram-bot-api
# Delete the file the local server wrote to disk once the job is done.
API_CLEANUP=true

# ── Limits ───────────────────────────────────────────────────────────────────
WORK_DIR=/var/tmp/unzipper
MAX_ARCHIVE_MB=2000
MAX_TOTAL_UNPACKED_MB=4096
MAX_ENTRIES=600
# Refuse an entry whose uncompressed/compressed ratio exceeds this (zip bomb).
MAX_COMPRESSION_RATIO=250
# Parallel jobs across all users. One job per user is enforced regardless.
MAX_CONCURRENT_JOBS=2

# ── Sending ──────────────────────────────────────────────────────────────────
# Re-encode oversized images so they can still go out as photos instead of
# falling back to documents.
NORMALIZE_PHOTOS=true
# Album size, 2..10.
ALBUM_SIZE=10
# Seconds to wait between media groups.
SEND_DELAY=1.0

# ── UI ───────────────────────────────────────────────────────────────────────
# Seconds between progress-card edits. Below ~1.5 Telegram starts throttling.
ANIM_INTERVAL=1.8

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# auto | always | never
LOG_COLOR=auto
LOG_FILE=
